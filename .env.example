# Chave da API do Gemini (obrigatoria).
# Obtenha em https://aistudio.google.com/apikey
GEMINI_API_KEY=AIzaSy-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Porta do servidor HTTP (opcional, padrao 3000)
PORT=3000

# Modelo da Camada de Otimizacao (IA 1) - tarefa curta, pede modelo rapido
OPTIMIZER_MODEL=gemini-3.1-flash-lite

# Modelo da Camada de Execucao (IA 2) - resposta final, pede mais raciocinio
EXECUTOR_MODEL=gemini-3.1-flash-lite

# Raciocinio por camada. Duas formas aceitas na mesma variavel:
#   - nivel   (Gemini 3):   minimal | low | medium | high
#   - tokens  (Gemini 2.5): inteiro; 0 desliga, -1 e automatico
OPTIMIZER_THINKING=low
EXECUTOR_THINKING=high

# Teto de tokens de saida por camada.
# Atencao: tokens de raciocinio consomem esse mesmo limite.
OPTIMIZER_MAX_OUTPUT_TOKENS=8192
EXECUTOR_MAX_OUTPUT_TOKENS=32768

# Tempo limite de cada chamada ao Gemini, em milissegundos
REQUEST_TIMEOUT_MS=300000

# Limite de caracteres aceito no campo "texto" da requisicao
MAX_INPUT_CHARS=8000

# Novas tentativas em caso de sobrecarga do modelo (503) e erros 5xx.
# 429 nao e repetido de proposito: na pratica significa cota esgotada.
RETRY_ATTEMPTS=3
RETRY_BASE_DELAY_MS=1000

# Senha compartilhada para POST /processar. Se ficar vazia, a rota fica ABERTA.
# Numa URL publica, defina sempre.
ACESSO_SENHA=
